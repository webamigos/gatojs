{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.integration.config.ts",
    "pool": "forks"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/features/*/services/**/*.ts",
    "src/shared/lib/auth/org-context.ts",
    "src/shared/lib/auth/require-module-access.ts",
    "!**/__tests__/**"
  ],
  "ignorePatterns": [
    "volumes",
    "reports",
    ".next",
    "playwright-report",
    "test-results",
    "docs",
    ".superpowers",
    ".worktrees"
  ],
  "concurrency": 1,
  "incremental": true,
  "incrementalFile": "reports/stryker-integration-incremental.json",
  "htmlReporter": {
    "fileName": "reports/mutation-integration/mutation.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-integration/mutation.json"
  },
  "reporters": ["html", "json", "clear-text", "progress"],
  "thresholds": {
    "high": 80,
    "low": 70,
    "break": null
  },
  "timeoutMS": 30000,
  "tempDirName": ".stryker-tmp"
}
