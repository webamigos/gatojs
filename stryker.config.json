{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "pool": "forks"
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/shared/lib/**/*.ts",
    "src/shared/utils/**/*.ts",
    "src/features/**/services/**/*.ts",
    "src/features/**/contracts/**/*.ts",
    "src/i18n/**/*.ts",
    "src/app/api/**/*.ts",
    "scripts/lib/**/*.ts",
    "packages/*/src/**/*.ts",
    "!**/__tests__/**",
    "!**/*.test.ts",
    "!packages/gato-cli/**",
    "!packages/create-gato-app/**",
    "!src/shared/lib/prisma.ts",
    "!src/shared/lib/logger.ts"
  ],
  "ignorePatterns": [
    "volumes",
    "reports",
    ".next",
    "playwright-report",
    "test-results",
    "docs",
    ".gato",
    ".superpowers",
    ".worktrees"
  ],
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": ["html", "json", "clear-text", "progress"],
  "thresholds": {
    "high": 85,
    "low": 75,
    "break": 75
  },
  "timeoutMS": 15000,
  "tempDirName": ".stryker-tmp"
}
