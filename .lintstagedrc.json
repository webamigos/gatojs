{
  "*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}": ["eslint --fix"],
  "*.{json,js,mjs,cjs,ts,jsx,tsx,mts,cts,html}": [
    "prettier --write --ignore-unknown"
  ],
  "packages/create-gato-app/**/*.{js,mjs,cjs,ts,mts,cts}": [
    "npm exec --workspace=create-gato-app -- eslint --fix"
  ],
  "packages/gato-cli/**/*.{js,mjs,cjs,ts,mts,cts}": [
    "npm exec --workspace=gato-cli -- eslint --fix"
  ]
}
