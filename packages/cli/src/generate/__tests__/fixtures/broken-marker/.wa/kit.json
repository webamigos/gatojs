{
  "kitVersion": "0.0.0",
  "modules": {
    "core": {
      "version": "1.0.0",
      "manifest": {
        "name": "core",
        "version": "1.0.0",
        "description": "core",
        "files": ["src/features/auth/**", "src/features/missing/**"],
        "env": [{ "name": "DATABASE_URL", "example": "postgresql://localhost/app" }]
      },
      "files": {}
    },
    "demo": {
      "version": "1.0.0",
      "manifest": {
        "name": "demo",
        "version": "1.0.0",
        "description": "demo",
        "files": ["src/features/demo/**"],
        "env": [{ "name": "DEMO_TOKEN", "example": "changeme" }],
        "schemaRelations": [{ "model": "User", "field": "demos Demo[]" }],
        "compose": "src/features/demo/compose.yml"
      },
      "files": {}
    }
  }
}
