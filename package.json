{
  "name": "gatojs",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:hooks": "node --test .claude/hooks/block-comments.test.mjs .claude/hooks/protect-tests.test.mjs",
    "test:mutation": "stryker run",
    "test:mutation:task": "stryker run --force --mutate",
    "test:mutation:integration": "stryker run stryker.integration.config.json",
    "test:mutation:gate": "tsx scripts/mutation-gate.ts",
    "db:generate": "prisma generate",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && turbo run test typecheck && npm run test:hooks",
    "wa": "node .wa/bin/wa.mjs",
    "postinstall": "prisma generate",
    "prepare": "husky",
    "admin:create": "tsx scripts/admin-create.ts",
    "test:e2e": "npm run build && rm -rf .next/standalone/.next/static && cp -R .next/static .next/standalone/.next/static && playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1159.0",
    "@base-ui/react": "^1.2.0",
    "@hookform/resolvers": "^5.9.2",
    "@opentelemetry/api-logs": "^0.218.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.218.0",
    "@opentelemetry/resources": "^2.7.1",
    "@opentelemetry/sdk-logs": "^3.1.1",
    "@prisma/adapter-pg": "^7.4.2",
    "@prisma/client": "^7.4.2",
    "@react-email/components": "^1.0.11",
    "@react-email/render": "^2.0.5",
    "@react-email/tailwind": "^2.0.7",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "^1.7.27",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "file-type": "^22.3.0",
    "lucide-react": "^0.577.0",
    "next": "16.4.6",
    "next-intl": "^4.9.0",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.2.1",
    "pg": "^8.20.0",
    "prisma": "^7.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.91.0",
    "resend": "^6.10.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.0.0",
    "sharp": "^0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@fast-check/vitest": "^0.5.0",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "better-call": "^1.4.4",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "fast-check": "^4.10.2",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "turbo": "^2.10.12",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "packageManager": "npm@11.21.1"
}
