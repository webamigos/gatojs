    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.1",
    "tailwindcss": "^4",
    "turbo": "^2.10.12",
    "typescript": "^5",
    "vite": "^8.0.14",
    "vitest": "^4.1.2"
  },
  "packageManager": "npm@11.21.1"
