{
  "version": "0.21.0",
  "repo": "https://github.com/webamigos/gatojs.git",
  "kitFormat": 3,
  "kitOnly": [
    "kit/**",
    "packages/gato-cli/**",
    "packages/create-gato-app/**",
    "scripts/kit/**",
    "docs/**",
    ".gato/**",
    ".superpowers/**",
    ".claude/handoffs/**",
    ".wa/kit.json",
    ".github/workflows/kit.yml",
    ".github/workflows/kit-mutation.yml",
    ".github/workflows/packages.yml",
    ".github/workflows/publish-packages.yml",
    ".github/workflows/release.yml",
    ".github/workflows/docker-platforms.yml",
    "prisma/migrations/.gitignore",
    "LICENSE",
    "NOTICE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    ".github/README.md",
    ".github/CODEOWNERS",
    ".github/dependabot.yml",
    ".github/PULL_REQUEST_TEMPLATE.md",
    ".github/ISSUE_TEMPLATE/**"
  ],
  "placeholders": {
    "projectName": "WA App",
    "projectSlug": "wa-app",
    "projectSnake": "wa_app"
  },
  "placeholderFiles": [
    "src/shared/config/project.ts",
    "package.json",
    "docker-compose.yml",
    "docker-compose.selfhost.yml",
    ".env.example",
    ".env.selfhost.example",
    "e2e/env.ts",
    ".github/workflows/e2e.yml",
    ".github/workflows/ci.yml",
    ".github/workflows/mutation.yml",
    "src/test/integration/database-url.ts",
    "README.md",
    "docker/uploads.compose.yml",
    "docker/uploads.selfhost.compose.yml",
    "ci/uploads.integration-steps.yml"
  ],
  "generatedFiles": [
    "src/modules.generated.ts",
    "src/modules.client.generated.ts",
    "src/i18n/locales.generated.ts"
  ],
  "managedFiles": ["package.json", "package-lock.json"],
  "seedFiles": ["README.md", "src/theme.css"]
}
