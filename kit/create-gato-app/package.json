{
  "name": "create-gato-app",
  "version": "0.1.0",
  "description": "Create a GatoJS project (Next.js kit) with one command",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "create-gato-app": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/webamigos/gatojs.git",
    "directory": "kit/create-gato-app"
  },
  "homepage": "https://github.com/webamigos/gatojs/tree/main/kit/create-gato-app#readme",
  "bugs": {
    "url": "https://github.com/webamigos/gatojs/issues"
  },
  "keywords": [
    "gatojs",
    "create",
    "scaffold",
    "nextjs",
    "starter",
    "cli"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/index.js",
    "prepack": "npm run clean && npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "lint": "eslint .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build",
    "test:mutation": "stryker run",
    "test:mutation:task": "stryker run --force --mutate",
    "test:smoke": "bash scripts/smoke-pack.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fast-check/vitest": "^0.5.0",
    "@stryker-mutator/core": "^10.1.1",
    "@stryker-mutator/typescript-checker": "^10.1.1",
    "@stryker-mutator/vitest-runner": "^10.1.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "fast-check": "^4.11.0",
    "globals": "^17.14.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^4.1.12"
  }
}
