{
  "name": "uploads",
  "version": "0.2.4",
  "description": "Pliki organizacji na dysku albo w magazynie S3",
  "requires": [],
  "files": [
    "prisma/schema/uploads.prisma",
    "src/features/uploads/**",
    "src/app/api/uploads/**",
    "docker/uploads.compose.yml",
    "ci/uploads.integration-steps.yml"
  ],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1172.0",
    "file-type": "^22.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {},
  "env": [
    {
      "name": "STORAGE_PROVIDER",
      "example": "local",
      "required": false
    },
    {
      "name": "STORAGE_LOCAL_PATH",
      "example": "./volumes/uploads",
      "required": false
    },
    {
      "name": "S3_ENDPOINT",
      "example": "http://localhost:9000",
      "required": false
    },
    {
      "name": "S3_REGION",
      "example": "auto",
      "required": false
    },
    {
      "name": "S3_ACCESS_KEY_ID",
      "example": "minioadmin",
      "required": false
    },
    {
      "name": "S3_SECRET_ACCESS_KEY",
      "example": "minioadmin",
      "required": false
    },
    {
      "name": "S3_BUCKET",
      "example": "{{projectSlug}}-uploads",
      "required": false
    },
    {
      "name": "S3_FORCE_PATH_STYLE",
      "example": "true",
      "required": false
    }
  ],
  "schemaRelations": [
    {
      "model": "User",
      "field": "uploads Upload[]"
    },
    {
      "model": "Organization",
      "field": "uploads Upload[]"
    }
  ],
  "compose": "docker/uploads.compose.yml",
  "ciSteps": "ci/uploads.integration-steps.yml",
  "workspaces": []
}
