{
  "name": "uploads",
  "version": "0.1.0",
  "description": "Pliki organizacji w magazynie S3 (MinIO lokalnie)",
  "requires": [],
  "files": [
    "src/features/uploads/**",
    "docker/uploads.compose.yml",
    "ci/uploads.integration-steps.yml"
  ],
  "dependencies": { "@aws-sdk/client-s3": "^3.1159.0" },
  "devDependencies": {},
  "env": [
    {
      "name": "S3_ENDPOINT",
      "example": "http://localhost:9000",
      "required": true
    },
    { "name": "S3_REGION", "example": "auto", "required": false },
    { "name": "S3_ACCESS_KEY_ID", "example": "minioadmin", "required": true },
    {
      "name": "S3_SECRET_ACCESS_KEY",
      "example": "minioadmin",
      "required": true
    },
    {
      "name": "S3_BUCKET",
      "example": "{{projectSlug}}-uploads",
      "required": true
    },
    { "name": "S3_FORCE_PATH_STYLE", "example": "true", "required": false }
  ],
  "schemaRelations": [],
  "compose": "docker/uploads.compose.yml",
  "ciSteps": "ci/uploads.integration-steps.yml",
  "workspaces": []
}
