{
  "name": "encryption",
  "version": "0.1.1",
  "description": "Per-organization envelope encryption (AES-256-GCM) with data keys wrapped by a master key",
  "requires": [],
  "files": [
    "packages/crypto/**",
    "prisma/schema/encryption.prisma",
    "src/features/encryption/**"
  ],
  "dependencies": {},
  "devDependencies": {},
  "env": [
    {
      "name": "ENCRYPTION_PROVIDER",
      "example": "local",
      "required": false
    },
    {
      "name": "ENCRYPTION_MASTER_KEY",
      "example": "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff",
      "required": true,
      "generate": "hex-32"
    }
  ],
  "schemaRelations": [
    { "model": "Organization", "field": "dataKey OrganizationDataKey?" }
  ],
  "compose": null,
  "workspaces": []
}
